# Copy this file to .env and adjust as needed. All values shown are defaults.

APP_NAME=SentinelTwin
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite by default -- no external database required.
# If running under WSL with the project on a /mnt/<drive> (Windows-drive)
# path, SQLite can intermittently fail with "disk I/O error" because DrvFs
# does not fully support the file locking SQLite relies on. If you hit that,
# point DATABASE_URL at a path on the native Linux filesystem instead, e.g.:
#   DATABASE_URL=sqlite:////home/<you>/sentineltwin-data/sentineltwin.db
DATABASE_URL=sqlite:///./data/sentineltwin.db

# Reproducibility for synthetic data generation and ML training.
RANDOM_SEED=42

# Synthetic data generation volume/frequency.
SYNTHETIC_DAYS=75
TELEMETRY_INTERVAL_MIN=15
NUM_OPERATORS=30
NUM_MACHINES=20
NUM_TRUCKS=8

# Comma-separated list of allowed frontend origins (for future React app).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ML artifact / generated data paths (relative to project root).
ML_MODELS_DIR=./data/models
GENERATED_DATA_DIR=./data/generated

# Fatigue / safety tuning.
BREAK_DUE_HOURS=2.0

# --- Optional Gemini integration ---
# Leave GEMINI_API_KEY empty/unset to use the local rule-based chatbot
# fallback (no external API calls, no cost). If set, the chatbot will use
# Gemini to phrase answers using retrieved knowledge-base context and
# operator metrics, and will automatically fall back to the local assistant
# if the API call fails for any reason.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
